# Copy these values into the Yandex Serverless Container revision environment.
# Do not rename this file to .env and do not commit filled secrets.

NODE_ENV=production
HOST=0.0.0.0
APP_BUILD_VERSION=<full-git-sha>

# Do not set PORT in Yandex Serverless Containers.
# In HTTP-server mode, Yandex injects PORT automatically and rejects manual PORT variables.

# Public browser config. These values are returned by /env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# Server-only config. This must never be exposed by /env, HTML, JS bundles, logs, or Object Storage.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
