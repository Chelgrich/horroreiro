# Copy this file to deploy/yandex/production.env.local and fill real values.
# deploy/yandex/production.env.local is ignored by git.
#
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never commit the filled file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only provider keys for the future automatic related-movies sync.
# Leave empty until the sync pipeline is enabled.
TMDB_READ_ACCESS_TOKEN=
TRAKT_API_KEY=
