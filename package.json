{
  "private": true,
  "type": "module",
  "scripts": {
    "docker:build": "docker build -t horroreiro-portable .",
    "smoke": "node tools/smoke-check.mjs",
    "smoke:docker": "node tools/docker-runtime-smoke.mjs",
    "smoke:docker:required": "node tools/docker-runtime-smoke.mjs --require-docker",
    "smoke:portable": "node tools/portable-runtime-smoke.mjs",
    "start:portable": "node server/server.mjs",
    "build:directors": "vite build",
    "size": "node tools/asset-size-report.mjs",
    "size:json": "node tools/asset-size-report.mjs --json",
    "size:compare": "node tools/asset-size-report.mjs --compare tools/asset-size-baseline.json"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "preact": "^10.29.7",
    "vite": "^8.1.4"
  }
